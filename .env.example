NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://localhost:5432/uemp
# Used by the test suite (database is dropped & recreated on every run)
TEST_DATABASE_URL=postgres://localhost:5432/uemp_test
# Set to true for managed Postgres providers that require TLS (Render, Neon, etc.)
DATABASE_SSL=false

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Session lifetime
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=120


LOG_LEVEL=info
