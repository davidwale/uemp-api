{
  "name": "uemp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:create": "tsx src/db/cli.ts create",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:rollback": "tsx src/db/cli.ts rollback",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:prod": "node dist/db/cli.js migrate && node dist/db/cli.js seed && node dist/server.js",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  },
  "description": "UEMP REST API (Express + Sequelize + PostgreSQL)",
  "engines": {
    "node": ">=20.11"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
